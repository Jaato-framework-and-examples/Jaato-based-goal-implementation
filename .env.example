# Copy to .env and set ONE provider credential.
#
# Provider and model live in .jaato/profiles/goal-actor.yaml — deliberately not
# here, so there is one source of truth. This file carries only the secret.
JAATO_OPENROUTER_API_KEY=

# ---- swapping providers ----
# Change `provider:` and `model:` in the profile, then set the matching key
# below instead. Nothing else in this repo changes.
#
#   anthropic     ANTHROPIC_API_KEY
#   openrouter    JAATO_OPENROUTER_API_KEY
#   ollama        (no key — local; set OLLAMA_HOST if not the default)
